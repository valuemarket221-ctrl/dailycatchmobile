# Copy this file outside git, replace every value, then run:
# scripts/mobile-release-preflight.sh path/to/.env.mobile.release
FIREBASE_API_KEY=replace_me
FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
FIREBASE_PROJECT_ID=replace_me
FIREBASE_STORAGE_BUCKET=replace_me.appspot.com
FIREBASE_MESSAGING_SENDER_ID=replace_me
FIREBASE_APP_ID=replace_me
API_BASE_URL=https://api.dailycatch.example
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
MAP_TILE_URL_TEMPLATE=https://tiles.dailycatch.example/{z}/{x}/{y}.png
MAP_TILE_USER_AGENT_PACKAGE_NAME=com.dailycatch.app
DEMO_FALLBACKS_ENABLED=false
